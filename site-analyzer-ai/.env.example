# ─────────────────────────────────────────────────────────────
# FREE option (recommended): OpenRouter free models
# Get a free key at https://openrouter.ai → Keys → Create Key
# No credit card required. 50 requests/day free (1000 after $10 top-up).
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Good free models (pick one):
#   google/gemma-4-26b-a4b-it:free
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3.5-lightning:free
#   qwen/qwen3.8-27b:free
#   thinkingmachines/inkling-small:free
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Optional metadata for OpenRouter rankings
OPENROUTER_SITE_URL=https://site-analyzer.app
OPENROUTER_APP_NAME=Site Analyzer

# ─────────────────────────────────────────────────────────────
# Paid option: Anthropic Claude (only if you have a key)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=   # only needed for proxies

# ─────────────────────────────────────────────────────────────
# Optional: real Core Web Vitals from Google PageSpeed Insights
# Free key: https://console.cloud.google.com → enable PageSpeed Insights API
# ─────────────────────────────────────────────────────────────
PSI_API_KEY=

# Crawl size (keep small on serverless / Vercel)
MAX_PAGES=8

# Set to 1 ONLY for local testing against localhost. Never in production.
ALLOW_LOCAL=0
